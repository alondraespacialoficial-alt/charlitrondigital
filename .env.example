# ============================================================================
# Variables de entorno — Charlitron Digital
# Copiar a .env.local para desarrollo. NUNCA commitear valores reales.
# Los valores de producción se configuran en Vercel → Settings → Environment.
# ============================================================================

# Supabase (proyecto rvvqhpbtqgjpzflopflv)
# URL del proyecto: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://rvvqhpbtqgjpzflopflv.supabase.co"

# Anon / publishable key — segura para frontend porque la seguridad
# real la aplican las políticas RLS. NUNCA usar la service_role key aquí.
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Dominio canónico del sitio (para canonical, OG y sitemap)
VITE_SITE_URL="https://charlitrondigital.com"

# --- Heredadas del template AI Studio (no requeridas para el MVP) ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# APP_URL="MY_APP_URL"
